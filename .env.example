# .env
# Environment variables for the Learning Accelerator.
# Copy this file: cp .env.example .env
# Then fill in your values.

# ── Model configuration ───────────────────────────────────────────────────
# All agents call the LiteLLM gateway, which routes to the configured
# provider (Ollama by default, see litellm_config.yaml).
# The model name lives in litellm_config.yaml, not here.
# The gateway itself runs as a docker container: make gateway
LITELLM_BASE_URL=http://localhost:4000
# The gateway runs in local mode (127.0.0.1 only, no auth). This value
# is accepted but not enforced; future master keys would live here too.
LITELLM_API_KEY=sk-local-gateway
LITELLM_MODEL=notes-helper

# Where the gateway reaches Ollama (used by litellm_config.yaml api_base,
# not by the app itself). Local or remote over HTTPS.
OLLAMA_BASE_URL=http://localhost:11434

# ── Storage ───────────────────────────────────────────────────────────────────
# Postgres checkpoint store (make postgres starts it on :5433).
# Set these to enable Postgres checkpointing: sessions then survive
# instance restarts and can be resumed by any instance sharing the
# database. Leave empty to use the legacy SQLite files below.
# Two databases keep terminal and web sessions isolated, exactly like
# the old checkpoints.db / checkpoints_ui.db file split.
CHECKPOINT_DB_URL=postgresql://notes:notes@localhost:5433/notes_helper
CHECKPOINT_DB_URL_UI=postgresql://notes:notes@localhost:5433/notes_helper_ui

# Legacy SQLite fallback, used only when the URLs above are empty
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# ── Langfuse observability ────────────────────────────────────────────────────
# Get keys from http://localhost:3000 after running: docker compose up -d
# Leave empty to run without observability (the system still works).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── A2A service URLs ──────────────────────────────────────────────────────────
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002

# ── A2A authentication ───────────────────────────────────────────────────────
# Shared bearer token for the A2A services. Empty/unset = auth disabled
# (local dev mode: same behavior as before). Set a strong random value in
# production: both services then reject calls without
# "Authorization: Bearer <A2A_BEARER_TOKEN>", and the client sends it
# automatically. The Agent Card documents this via securitySchemes.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
A2A_BEARER_TOKEN=

# ── A2A feature toggles ───────────────────────────────────────────────────────
# Set to "false" to use local quiz generation instead of the A2A service.
# Useful when running main.py without starting the A2A services first.
USE_A2A_QUIZ=true

# Set to "false" to skip CrewAI Study Buddy calls when scores are low.
USE_STUDY_BUDDY=true
